<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glossentry PUBLIC "-//OASIS//DTD DITA Glossary Entry//EN" "glossentry.dtd">
<glossentry id="part">
    <glossterm>Part</glossterm>
    <glossdef>
        <p>
            A part is an identifiable element that a device can be disassembled into.
        </p>
        <p>
            See also: <term keyref="artifact">Artifact</term>, <term keyref="device">Device</term>
        </p>
    </glossdef>
</glossentry>
