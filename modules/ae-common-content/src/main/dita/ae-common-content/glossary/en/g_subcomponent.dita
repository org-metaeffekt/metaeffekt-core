<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glossentry PUBLIC "-//OASIS//DTD DITA Glossary Entry//EN" "glossentry.dtd">
<glossentry id="subcomponent">
    <glossterm>Subcomponent</glossterm>
    <glossdef>
        <p>
            A subcomponent is a component that is embedded in or linked by another component.
        </p>
        <p>
            See also: <term keyref="component">Components</term>
        </p>
    </glossdef>
</glossentry>
