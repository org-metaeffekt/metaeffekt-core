<glossentry id="subcomponent">
    <glossterm>Subcomponent</glossterm>
    <glossdef>
        A subcomponent is a component that is embedded in or linked by another component.
        <p>
            See also: <i><xref keyref="component">Component</xref></i>
        </p>
    </glossdef>
    <glossBody>
        <glossSurfaceForm>subcomponents</glossSurfaceForm>
    </glossBody>
</glossentry>
