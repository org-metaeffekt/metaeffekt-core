<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glossentry PUBLIC "-//OASIS//DTD DITA Glossary Entry//EN" "glossentry.dtd">
<glossentry id="part">
    <glossterm>Teil</glossterm>
    <glossdef>
        <p>
            Teile sind identifizierbare Hardware-Elemente. Geräte können in Teilen erfasst werden.
        </p>
        <p>
            Siehe auch: <term keyref="artifact">Artefakt</term>, <term keyref="device">Gerät</term>
        </p>
    </glossdef>
</glossentry>
