<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glossentry PUBLIC "-//OASIS//DTD DITA Glossary Entry//EN" "glossentry.dtd">
<glossentry id="subcomponent">
    <glossterm>Unterkomponente</glossterm>
    <glossdef>
        <p>
            Eine Unterkomponente ist eine Komponente, die in eine andere Komponente eingebettet oder von dieser intergriert wird.
        </p>
        <p>
            Siehe auch: <term keyref="component">Komponenten</term>
        </p>
    </glossdef>
</glossentry>
