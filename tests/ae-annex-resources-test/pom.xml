<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <artifactId>ae-annex-resources-test</artifactId>
    <name>${project.artifactId}</name>
    <packaging>jar</packaging>

    <parent>
        <groupId>org.metaeffekt.core</groupId>
        <artifactId>ae-core-plugin-management-pom</artifactId>
        <version>0.156-SNAPSHOT</version>
        <relativePath>../../poms/ae-core-plugin-management-pom</relativePath>
    </parent>

    <build>
        <plugins>
            <plugin>
                <groupId>org.metaeffekt.core</groupId>
                <artifactId>ae-inventory-maven-plugin</artifactId>
                <version>${ae.core.version}</version>
                <executions>
                    <execution>
                        <id>aggregate-licenses-from-reference-inventory</id>
                        <goals>
                            <goal>aggregate-reference-licenses</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <inventoryFile>${project.basedir}/src/test/resources/reference-inventory/inventory/artifact-inventory-01.xls</inventoryFile>
                            <referenceInventoryDir>${project.basedir}/src/test/resources/reference-inventory/inventory</referenceInventoryDir>
                            <referenceComponentsDir>../components</referenceComponentsDir>
                            <referenceLicensesDir>../licenses</referenceLicensesDir>
                            <targetComponentsDir>${project.build.directory}/components</targetComponentsDir>
                            <targetLicensesDir>${project.build.directory}/licenses</targetLicensesDir>
                            <failOnMissingLicenseFile>false</failOnMissingLicenseFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
