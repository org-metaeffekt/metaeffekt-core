<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Concept//EN" "http://docs.oasis-open.org/dita/v1.1/OS/dtd/topic.dtd">
<topic id="tpc_notice">
    <title>$utils.getText("document.notice.title")</title>
    <body>
        <section>
            <title>$utils.getText("document.notice.trademarks.title")</title>
            <p id="trademarks">$utils.getText("document.notice.trademarks.text")</p>
        </section>
        <section>
            <title>$utils.getText("document.notice.external.materials.title")</title>
            <p id="external-data">$utils.getText("document.notice.external.materials.text.1")</p>
        </section>
        <section>
            <title>$utils.getText("document.notice.tpc.vulnerabilities.title")</title>
            <p id="vulnerabilities">$utils.getText("document.notice.tpc.vulnerabilities.text")</p>
        </section>
        <section>
            <title>$utils.getText("document.notice.assessment.categories.title")</title>
            <p id="categories">
                $utils.getText("document.notice.assessment.categories.intro")
                <ul>
                    <li><b>$utils.getText("document.notice.category.affected.title")</b> - $utils.getText("document.notice.category.affected.desc")</li>
                    <li><b>$utils.getText("document.notice.category.potentially.affected.title")</b> - $utils.getText("document.notice.category.potentially.affected.desc")</li>
                    <li><b>$utils.getText("document.notice.category.not.affected.title")</b> - $utils.getText("document.notice.category.not.affected.desc")</li>
                </ul>
                $utils.getText("document.notice.assessment.categories.outro")
            </p>
        </section>
        <section>
            <title>$utils.getText("document.notice.assessment.status.title")</title>
            <p id="status">
                $utils.getText("document.notice.assessment.status.intro")
                <ul>
                    <li><b>$utils.getText("document.notice.status.applicable.title")</b> - $utils.getText("document.notice.status.applicable.desc")</li>
                    <li><b>$utils.getText("document.notice.status.not.applicable.title")</b> - $utils.getText("document.notice.status.not.applicable.desc")</li>
                    <li><b>$utils.getText("document.notice.status.in.review.title")</b> - $utils.getText("document.notice.status.in.review.desc")</li>
                    <li><b>$utils.getText("document.notice.status.insignificant.title")</b> - $utils.getText("document.notice.status.insignificant.desc")</li>
                    <li><b>$utils.getText("document.notice.status.void.title")</b> - $utils.getText("document.notice.status.void.desc")</li>
                </ul>
            </p>
        </section>
        <section>
            <title>$utils.getText("document.notice.assessment.steps.title")</title>
            <p id="assessment">
                $utils.getText("document.notice.assessment.steps.intro")
                <ol>
                    <li>$utils.getText("document.notice.assessment.step.1")</li>
                    <li>$utils.getText("document.notice.assessment.step.2")</li>
                    <li>$utils.getText("document.notice.assessment.step.3")</li>
                    <li>$utils.getText("document.notice.assessment.step.4")</li>
                    <li>$utils.getText("document.notice.assessment.step.5")</li>
                    <li>$utils.getText("document.notice.assessment.step.6")</li>
                </ol>
            </p>
        </section>
        <section>
            <title>$utils.getText("document.notice.severity.metrics.title")</title>
            <p id="scoring">$utils.getText("document.notice.severity.metrics.1")</p>
            <p id="scoring-metrics">$utils.getText("document.notice.severity.metrics.2")</p>
            <p id="scoring-backgrounds">$utils.getText("document.notice.severity.metrics.3")</p>
            <p>
                $utils.getText("document.notice.severity.metrics.4")
                <table id="severity_scheme">
                    <title>$utils.getText("document.notice.severity.scheme.title")</title>
                    <tgroup cols="5">
                        <colspec colname="COLSPEC0" colnum="1" colwidth="15*" />
                        <colspec colname="COLSPEC1" colnum="2" colwidth="20*" />
                        <colspec colname="COLSPEC2" colnum="3" colwidth="65*" />
                        <thead>
                            <row>
                                <entry colname="COLSPEC0" valign="middle">$utils.getText("document.notice.severity.table.header.1")</entry>
                                <entry colname="COLSPEC1" valign="middle">$utils.getText("document.notice.severity.table.header.2")</entry>
                                <entry colname="COLSPEC2" valign="middle">$utils.getText("document.notice.severity.table.header.3")</entry>
                            </row>
                        </thead>
                        <tbody>
                            <row>
                                <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                                    <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#cacecf" />
                                    <svg:text text-anchor="middle" alignment-baseline="central" fill="black">
                                        <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.notice.severity.none.title")</svg:tspan>
                                    </svg:text>
                                </svg:svg></svg-container></entry>
                                <entry valign="middle">0.0</entry>
                                <entry valign="middle">$utils.getText("document.notice.severity.none.remarks")</entry>
                            </row>
                            <row>
                                <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                                    <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#ffcc00" />
                                    <svg:text text-anchor="middle" alignment-baseline="central" fill="black">
                                        <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.notice.severity.low.title")</svg:tspan>
                                    </svg:text>
                                </svg:svg></svg-container></entry>
                                <entry valign="middle">0.1 - 3.9</entry>
                                <entry valign="middle"></entry>
                            </row>
                            <row>
                                <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                                    <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#ff9b05" />
                                    <svg:text text-anchor="middle" alignment-baseline="central" fill="black">
                                        <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.notice.severity.medium.title")</svg:tspan>
                                    </svg:text>
                                </svg:svg></svg-container></entry>
                                <entry valign="middle">4.0 - 6.9</entry>
                                <entry valign="middle"></entry>
                            </row>
                            <row>
                                <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                                    <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#ff5a0e" />
                                    <svg:text text-anchor="middle" alignment-baseline="central" fill="white">
                                        <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.notice.severity.high.title")</svg:tspan>
                                    </svg:text>
                                </svg:svg></svg-container></entry>
                                <entry valign="middle">7.0 - 8.9</entry>
                                <entry valign="middle">$utils.getText("document.notice.severity.high.remarks")</entry>
                            </row>
                            <row>
                                <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                                    <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#ff172d" />
                                    <svg:text text-anchor="middle" alignment-baseline="central" fill="white">
                                        <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.notice.severity.critical.title")</svg:tspan>
                                    </svg:text>
                                </svg:svg></svg-container></entry>
                                <entry valign="middle">9.0 - 10.0</entry>
                                <entry valign="middle">$utils.getText("document.notice.severity.critical.remarks")</entry>
                            </row>
                        </tbody>
                    </tgroup>
                </table>
            </p>
        </section>

#set($hasPriority = false)
#if($inventory && $vulnerabilityAdapter && !$configParams.isHidePriorityInformation() && $configParams.getCustomParams().get("document.notice.prioritization.enabled") == 'true')
    #foreach($vulnerability in $inventory.getVulnerabilities())
        #if($vulnerabilityAdapter.getPriorityLabel($vulnerability))
            #set($hasPriority = true)
            #break
        #end
    #end
#end
#if($hasPriority)
        <section>
            <title>$utils.getText("document.notice.prioritization.title")</title>
            <p>$utils.getText("document.notice.prioritization.text.1")</p>
            <p>$utils.getText("document.notice.prioritization.text.2")</p>
        </section>
#end

        <section>
            <title>$utils.getText("document.notice.external.sources.title")</title>
            <p>$utils.getText("document.notice.external.sources.1")</p>
            <p>$utils.getText("document.notice.external.sources.2")</p>
        </section>
        <section>
            <title>$utils.getText("document.notice.copyright.title")</title>
            <p id="copyright">
                $utils.getText("document.notice.copyright.text", ["#[[${document.copyright.year}]]#", "#[[${organization.name}]]#"])
            </p>
        </section>
    </body>
</topic>
