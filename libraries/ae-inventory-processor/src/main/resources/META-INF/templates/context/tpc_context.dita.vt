<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "http://docs.oasis-open.org/dita/v1.1/OS/dtd/topic.dtd">
<topic id="tpc_context" xmlns:ditaarch="http://dita.oasis-open.org/architecture/2005/">
    <title>$utils.getText("document.context.title")</title>
    <body>
        #if($configParams.getCustomParams().get("document.context.intro"))
        <p>$configParams.getCustomParams().get("document.context.intro")</p>
        #else
        <p>$utils.getText($configParams.getCustomParams().get("document.context.intro.key"))</p>
        #end

        <section>
            <title>$utils.getText("document.context.severity.metrics.title")</title>
            <p id="scoring">$utils.getText("document.context.severity.metrics.1")</p>
            <p id="scoring-metrics">$utils.getText("document.context.severity.metrics.2")</p>
            <p>
                <!-- https://nvd.nist.gov/vuln-metrics/cvss; https://www.first.org/cvss/v3.1/specification-document -->
                $utils.getText("document.context.severity.metrics.3")
                <table id="severity_scheme">
                    <title>$utils.getText("document.context.severity.scheme.title")</title>
                    <tgroup cols="5">
                        <colspec colname="COLSPEC0" colnum="1" colwidth="15*" />
                        <colspec colname="COLSPEC1" colnum="2" colwidth="20*" />
                        <colspec colname="COLSPEC2" colnum="3" colwidth="65*" />
                        <thead>
                            <row>
                                <entry colname="COLSPEC0" valign="middle">$utils.getText("document.context.severity.table.header.1")</entry>
                                <entry colname="COLSPEC1" valign="middle">$utils.getText("document.context.severity.table.header.2")</entry>
                                <entry colname="COLSPEC2" valign="middle">$utils.getText("document.context.severity.table.header.3")</entry>
                            </row>
                        </thead>

                        <tbody>
                            <row>
                                <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                                    <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#cacecf" />
                                    <svg:text text-anchor="middle" alignment-baseline="central" fill="black">
                                        <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.context.severity.none.title")</svg:tspan>
                                    </svg:text>
                                </svg:svg></svg-container></entry>
                                <entry valign="middle">0.0</entry>
                                <entry valign="middle">$utils.getText("document.context.severity.none.remarks")</entry>
                            </row>
                            <row>
                                <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                                    <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#ffcc00" />
                                    <svg:text text-anchor="middle" alignment-baseline="central" fill="black">
                                        <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.context.severity.low.title")</svg:tspan>
                                    </svg:text>
                                </svg:svg></svg-container></entry>
                                <entry valign="middle">0.1 - 3.9</entry>
                                <entry valign="middle">&nbsp;</entry>
                            </row>
                            <row>
                                <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                                    <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#ff9b05" />
                                    <svg:text text-anchor="middle" alignment-baseline="central" fill="black">
                                        <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.context.severity.medium.title")</svg:tspan>
                                    </svg:text>
                                </svg:svg></svg-container></entry>
                                <entry valign="middle">4.0 - 6.9</entry>
                                <entry valign="middle">&nbsp;</entry>
                            </row>
                            <row>
                                <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                                    <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#ff5a0e" />
                                    <svg:text text-anchor="middle" alignment-baseline="central" fill="white">
                                        <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.context.severity.high.title")</svg:tspan>
                                    </svg:text>
                                </svg:svg></svg-container></entry>
                                <entry valign="middle">7.0 - 8.9</entry>
                                <entry valign="middle">$utils.getText("document.context.severity.high.remarks")</entry>
                            </row>
                            <row>
                                <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                                    <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#ff172d" />
                                    <svg:text text-anchor="middle" alignment-baseline="central" fill="white">
                                        <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.context.severity.critical.title")</svg:tspan>
                                    </svg:text>
                                </svg:svg></svg-container></entry>
                                <entry valign="middle">9.0 - 10.0</entry>
                                <entry valign="middle">&nbsp;</entry>
                            </row>
                        </tbody>
                    </tgroup>
                </table>
            </p>
            #if($configParams.getCustomParams().get("document.context.metrics.epss.enabled") == 'true')
            <p>$utils.getText("document.context.metrics.epss.text")</p>
            #end
        </section>

        #if($configParams.getCustomParams().get("document.context.assessment.status.enabled") == 'true')
        <section>
            <title>$utils.getText("document.context.assessment.status.title")</title>
            <p id="status">
                $utils.getText("document.context.assessment.status.intro")
            <ul>
                <li><b>$utils.getText("document.context.status.applicable.title")</b> - $utils.getText("document.context.status.applicable.desc")</li>
                <li><b>$utils.getText("document.context.status.not.applicable.title")</b> - $utils.getText("document.context.status.not.applicable.desc")</li>
                <li><b>$utils.getText("document.context.status.insignificant.title")</b> - $utils.getText("document.context.status.insignificant.desc")</li>
                <li><b>$utils.getText("document.context.status.void.title")</b> - $utils.getText("document.context.status.void.desc")</li>
                <li><b>$utils.getText("document.context.status.in.review.title")</b> - $utils.getText("document.context.status.in.review.desc")</li>
            </ul>
            </p>
        </section>
        #end

        #if($configParams.getCustomParams().get("document.context.remediation.enabled") == 'true')
        <section>
            <title>$utils.getText("document.context.remediation.title")</title>
            <p id="remediation">
                $utils.getText("document.context.remediation.intro")
            <ul>
                <li>$utils.getText("document.context.remediation.step.1")</li>
                <li>$utils.getText("document.context.remediation.step.2")</li>
                <li>$utils.getText("document.context.remediation.step.3")</li>
            </ul>
            </p>
        </section>
        #end

        #if($configParams.getCustomParams().get("document.context.prioritization.enabled") == 'true')
        <section>
            <title>$utils.getText("document.context.prioritization.title")</title>
            <p>$utils.getText("document.context.prioritization.text.1")</p>
            <p>$utils.getText("document.context.prioritization.text.2")</p>
            <p>$utils.getText("document.context.prioritization.text.3")</p>
            <p>
                $utils.getText("document.context.prioritization.text.4")
            <table id="priority_scheme">
                <title>$utils.getText("document.context.prioritization.scheme.title")</title>
                <tgroup cols="5">
                    <colspec colname="COLSPEC0" colnum="1" colwidth="15*" />
                    <colspec colname="COLSPEC1" colnum="2" colwidth="20*" />
                    <colspec colname="COLSPEC2" colnum="3" colwidth="65*" />
                    <thead>
                    <row>
                        <entry colname="COLSPEC0" valign="middle">$utils.getText("document.context.prioritization.table.header.1")</entry>
                        <entry colname="COLSPEC1" valign="middle">$utils.getText("document.context.prioritization.table.header.2")</entry>
                        <entry colname="COLSPEC2" valign="middle">$utils.getText("document.context.prioritization.table.header.3")</entry>
                    </row>
                    </thead>

                    <tbody>
                    <row>
                        <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                            <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#cacecf" />
                            <svg:text text-anchor="middle" alignment-baseline="central" fill="black">
                                <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.context.prioritization.default.title")</svg:tspan>
                            </svg:text>
                        </svg:svg></svg-container></entry>
                        <entry valign="middle">0.0</entry>
                        <entry valign="middle">$utils.getText("document.context.prioritization.default.desc")</entry>
                    </row>
                    <row>
                        <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                            <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#ff9b05" />
                            <svg:text text-anchor="middle" alignment-baseline="central" fill="black">
                                <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.context.prioritization.elevated.title")</svg:tspan>
                            </svg:text>
                        </svg:svg></svg-container></entry>
                        <entry valign="middle">0.1 - 6.9</entry>
                        <entry valign="middle">$utils.getText("document.context.prioritization.elevated.desc")</entry>
                    </row>
                    <row>
                        <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                            <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#ff5a0e" />
                            <svg:text text-anchor="middle" alignment-baseline="central" fill="white">
                                <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.context.prioritization.due.title")</svg:tspan>
                            </svg:text>
                        </svg:svg></svg-container></entry>
                        <entry valign="middle">7.0 - 8.9</entry>
                        <entry valign="middle">$utils.getText("document.context.prioritization.due.desc")</entry>
                    </row>
                    <row>
                        <entry valign="middle"><svg-container><svg:svg xmlns:svg="http://www.w3.org/2000/svg" width="56px" height="17px">
                            <svg:rect x="0" y="0" rx="3" ry="3" width="56" height="17" style="fill:#ff172d" />
                            <svg:text text-anchor="middle" alignment-baseline="central" fill="white">
                                <svg:tspan x="28" y="12" font-weight="bold">$utils.getText("document.context.prioritization.escalate.title")</svg:tspan>
                            </svg:text>
                        </svg:svg></svg-container></entry>
                        <entry valign="middle">9.0 or &gt;9.0</entry>
                        <entry valign="middle">$utils.getText("document.context.prioritization.escalate.desc")</entry>
                    </row>
                    </tbody>
                </tgroup>
            </table>
            </p>
        </section>
        #end

        #if($configParams.getCustomParams().get("document.context.exploitability.enabled") == 'true')
        <section>
            <title>$utils.getText("document.context.exploitability.title")</title>
            <p>
                $utils.getText("document.context.exploitability.intro")
            <ul>
                <li><abbreviated-form keyref="epss"/> - $utils.getText("document.context.exploitability.source.epss")</li>
                <li><abbreviated-form keyref="cvss"/> - $utils.getText("document.context.exploitability.source.cvss")</li>
                <li><abbreviated-form keyref="kev"/> - $utils.getText("document.context.exploitability.source.kev")</li>
            </ul>
            </p>
            <p>$utils.getText("document.context.exploitability.text.1")</p>
            <p>
                $utils.getText("document.context.exploitability.text.2")
            <ul>
                <li><b>$utils.getText("document.context.exploitability.evident.title")</b> - $utils.getText("document.context.exploitability.evident.desc")</li>
                <li><b>$utils.getText("document.context.exploitability.unconfirmed.title")</b> - $utils.getText("document.context.exploitability.unconfirmed.desc")</li>
                <li><b>$utils.getText("document.context.exploitability.not.evident.title")</b> - $utils.getText("document.context.exploitability.not.evident.desc")</li>
                <li><b>$utils.getText("document.context.exploitability.undefined.title")</b> - $utils.getText("document.context.exploitability.undefined.desc")</li>
            </ul>
            </p>
        </section>
        #end

        #if($configParams.getCustomParams().get("document.context.threshold.enabled") == 'true')
        <section>
            <title>$utils.getText("document.context.threshold.title")</title>
            <p>$utils.getText("inventory-report-vulnerability.vulnerability-threshold")</p>
        </section>
        #end
    </body>
</topic>
