<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE bookmap PUBLIC "-//OASIS//DTD DITA BookMap//EN" "http://docs.oasis-open.org/dita/v1.1/OS/dtd/bookmap.dtd">
<bookmap id="map_$parentId">
#foreach($child in $children)
    <chapter href="../${child.getIdentifier()}/map_${child.getIdentifier()}.ditamap" format="ditamap" />
#end
</bookmap>
