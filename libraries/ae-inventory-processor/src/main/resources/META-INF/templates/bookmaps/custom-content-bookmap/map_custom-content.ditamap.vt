<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE bookmap PUBLIC "-//OASIS//DTD DITA BookMap//EN" "http://docs.oasis-open.org/dita/v1.1/OS/dtd/bookmap.dtd">
<bookmap id="map_custom_content">
    <chapter>
        #foreach($file in $customFiles)
        <topicref href="$file" />
        #end
    </chapter>
</bookmap>
